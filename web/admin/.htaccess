# Admin assets change with every CMS update, and the interface is low-traffic, so
# a long max-age buys almost nothing but can leave stale JS/CSS in the browser for
# weeks (and mismatch a partially-updated ES module graph). Instead, let the browser
# cache the files but always revalidate against the server: Apache's ETag /
# Last-Modified turn each check into a cheap 304, and a changed file is picked up
# immediately. This covers the whole ES module import graph, which a query-string
# cache-buster cannot. `private` keeps shared proxies from storing admin responses.
# Disable the long Expires headers the admin would otherwise inherit from the
# public site's web/.htaccess. A far-future Expires next to `no-cache` is
# contradictory and can make Safari serve stale files, so switch it off here.
<IfModule mod_expires.c>
	ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
	<FilesMatch "\.(css|js|mjs|svg|png|jpe?g|gif|ico|woff2?|ttf|eot|otf)$">
		Header set Cache-Control "no-cache, private"
	</FilesMatch>
</IfModule>

RewriteEngine On

# Run everything but real files through index.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php?/$1 [L]